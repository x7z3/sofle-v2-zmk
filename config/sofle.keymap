#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define MAC    0
#define WIN    1
#define FUNC   2
#define SYMB   3
#define SYS    4

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        mac {
            label = "mac";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE  &kp N1  &kp N2        &kp N3        &kp N4     &kp N5                                  &kp N6  &kp N7     &kp N8         &kp N9         &kp N0    &kp BACKSPACE
&kp GRAVE   &kp Q   &kp W         &kp E         &kp R      &kp T                                   &kp Y   &kp U      &kp I          &kp O          &kp P     &kp BACKSLASH
&kp TAB     &kp A   &kp S         &kp D         &kp F      &kp G                                   &kp H   &kp J      &kp K          &kp L          &kp SEMI  &kp SQT
&kp LSHFT   &kp Z   &kp X         &kp C         &kp V      &kp B   &kp C_MUTE    &kp C_PLAY_PAUSE  &kp N   &kp M      &kp COMMA      &kp DOT        &kp FSLH  &kp RSHFT
                    &kp LEFT_ALT  &kp LEFT_WIN  &kp LCTRL  &mo 2   &kp SPACE     &kp SPACE         &mo 3   &kp RCTRL  &kp RIGHT_WIN  &kp RIGHT_ALT
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOLUME_UP>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };

        windows {
            label = "win";
            bindings = <
&kp ESCAPE  &kp N1  &kp N2        &kp N3        &kp N4     &kp N5                                  &kp N6  &kp N7     &kp N8     &kp N9         &kp N0    &kp BACKSPACE
&kp GRAVE   &kp Q   &kp W         &kp E         &kp R      &kp T                                   &kp Y   &kp U      &kp I      &kp O          &kp P     &kp BACKSLASH
&kp TAB     &kp A   &kp S         &kp D         &kp F      &kp G                                   &kp H   &kp J      &kp K      &kp L          &kp SEMI  &kp SQT
&kp LSHFT   &kp Z   &kp X         &kp C         &kp V      &kp B   &kp C_MUTE    &kp C_PLAY_PAUSE  &kp N   &kp M      &kp COMMA  &kp DOT        &kp FSLH  &kp RSHFT
                    &kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL  &mo 2   &kp SPACE     &kp SPACE         &mo 3   &kp RCTRL  &kp RALT   &kp RIGHT_WIN
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };

        func {
            label = "fun";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp F12  &kp F1                &kp F2                &kp F3        &kp F4            &kp F5                      &kp F6         &kp F7      &kp F8        &kp F9        &kp F10           &kp F11
&trans   &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp END       &kp HOME          &trans                      &kp PAGE_DOWN  &kp PG_UP   &kp INSERT    &kp ENTER     &kp C_PLAY_PAUSE  &kp C_PREV
&trans   &kp LEFT_ALT          &kp LCTRL             &kp DELETE    &kp LEFT_COMMAND  &mkp MB2                    &kp LEFT       &kp DOWN    &kp UP_ARROW  &kp RIGHT     &trans            &kp PRINTSCREEN
&trans   &mmv MOVE_LEFT        &mmv MOVE_DOWN        &mmv MOVE_UP  &mmv MOVE_RIGHT   &mkp MB1  &sl 4     &trans  &kp C_NEXT     &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans            &trans
                               &trans                &trans        &trans            &none     &trans    &trans  &mo 4          &trans      &trans        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };

        symbols {
            label = "sym";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&kp F12    &kp F1          &kp F2           &kp F3            &kp F4             &kp F5                           &kp F6         &kp F7        &kp F8        &kp F9        &kp F10       &kp F11
&kp GRAVE  &kp NUMBER_1    &kp N2           &kp N3            &kp N4             &kp N5                           &kp N6         &kp N7        &kp N8        &kp N9        &kp N0        &kp MINUS
&kp TILDE  &kp LS(EXCL)    &kp LS(AT)       &kp LS(POUND)     &kp LS(DLLR)       &kp LS(PRCNT)                    &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &kp LS(UNDER)
&trans     &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans         &trans    &sl 4   &kp BACKSLASH  &kp EQUAL     &kp PLUS      &trans        &trans        &trans
                           &trans           &trans            &trans             &mo 4          &trans    &trans  &none          &trans        &trans        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };

        system {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            label = "sys";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_SEL 3  &bt BT_SEL 4                             &trans           &trans           &trans           &trans           &trans  &trans
&studio_unlock  &trans        &tog 1        &ext_power EP_TOG  &sys_reset    &out OUT_TOG                             &trans           &sys_reset       &trans           &trans           &trans  &studio_unlock
&kp CAPS        &trans        &tog 0        &trans             &trans        &trans                                   &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &trans  &trans
&trans          &soft_off     &trans        &trans             &trans        &trans        &trans    &rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &trans  &trans
                              &trans        &trans             &trans        &trans        &trans    &trans           &trans           &trans           &trans           &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };
    };
};
